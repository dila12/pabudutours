# Gmail account used to send booking/contact emails (must match SMTP login)
EMAIL_USER=Pabudutour@gmail.com

# Gmail App Password (not your normal Gmail password)
# Create at: Google Account → Security → 2-Step Verification → App passwords
EMAIL_PASS=your-16-char-app-password

# Optional: comma-separated admin inbox list (defaults to Pabudu team emails)
# ADMIN_EMAILS=Pabudutour@gmail.com,other@email.com
