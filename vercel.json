{
  "version": 2,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pabudutours.com" }],
      "destination": "https://www.pabudutours.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pabudutours.com" }],
      "destination": "https://www.pabudutours.com/:path*",
      "permanent": true
    },
    {
      "source": "/de",
      "destination": "/?lang=de",
      "permanent": true
    },
    {
      "source": "/de/:path*",
      "destination": "/:path*?lang=de",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/?lang=ru",
      "permanent": true
    },
    {
      "source": "/ru/:path*",
      "destination": "/:path*?lang=ru",
      "permanent": true
    },
    {
      "source": "/hi",
      "destination": "/?lang=hi",
      "permanent": true
    },
    {
      "source": "/hi/:path*",
      "destination": "/:path*?lang=hi",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/it",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/fr",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/pl",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pl/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/2-day-sri-lanka-tour",
      "destination": "/2-day-ella-kandy-private-tour-sri-lanka",
      "permanent": true
    },
    {
      "source": "/2-day-tour",
      "destination": "/2-day-ella-kandy-private-tour-sri-lanka",
      "permanent": true
    },
    {
      "source": "/3-day-sri-lanka-tour",
      "destination": "/3-day-sigiriya-kandy-ella-yala-tour",
      "permanent": true
    },
    {
      "source": "/3-day-tour",
      "destination": "/3-day-sigiriya-kandy-ella-yala-tour",
      "permanent": true
    },
    {
      "source": "/5-day-tour",
      "destination": "/5-day-sri-lanka-tour",
      "permanent": true
    },
    {
      "source": "/7-day-tour",
      "destination": "/7-day-sri-lanka-tour",
      "permanent": true
    },
    {
      "source": "/10-day-tour",
      "destination": "/10-day-sri-lanka-tour",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/our-services",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/packages",
      "destination": "/tour-packages",
      "permanent": true
    },
    {
      "source": "/tours",
      "destination": "/tour-packages",
      "permanent": true
    },
    {
      "source": "/restaurants-in-sri-lanka",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/restaurant-sri-lanka",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/restaurants",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/booking/:filecode*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/booking/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://translate.google.com https://translate.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://translate.googleapis.com; frame-src https://www.googletagmanager.com https://translate.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me mailto:"
        }
      ]
    }
  ]
}
